:host{display:inline-block;line-height:0;pointer-events:none}
.layered-knowledge{position:relative;display:block;overflow:visible;background:transparent}
.phase-image,.q-canvas{position:absolute;left:0;top:0;width:100%;height:100%;display:block;opacity:0;transition:opacity 140ms ease;background:transparent}
.phase-image.is-visible,.q-canvas.is-visible{opacity:1}
.intro-image.is-playing{animation:knowledgeIntro 620ms ease-out both}
@keyframes knowledgeIntro{0%{transform:scale(.965) translateY(1.4%);opacity:.86}58%{transform:scale(1.018) translateY(-.5%);opacity:1}100%{transform:scale(1) translateY(0);opacity:1}}
