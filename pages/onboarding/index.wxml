<view class="page onboarding {{phase === 'welcome' || phase === 'boot' ? 'welcome-page' : (step === 'access' ? 'gate-page' : 'has-navbar')}} {{reduceMotion ? 'reduce-motion' : ''}}" style="padding-top:{{topPad}}px">
  <!-- 自绘通知（替代 wx.showToast 系统样式） -->
  <view wx:if="{{uvToast.show}}" class="uv-toast {{uvToast.type === 'err' ? 'uv-toast-err' : uvToast.type === 'star' ? '' : 'uv-toast-info'}}">
    <text class="uv-toast-star">{{uvToast.type === 'err' ? '✗' : uvToast.type === 'star' ? '★' : '✦'}}</text>
    <text class="uv-toast-txt">{{uvToast.text}}</text>
    <view class="uv-toast-bar"></view>
  </view>

  <!-- 冷启动校验：奶油底，不渲染星门，避免一闪 -->
  <view wx:if="{{phase === 'boot'}}" class="boot-wait">
    <xingcheng-q-scene scene="loading" motion="{{reduceMotion ? 'still' : 'auto'}}" size="240"/>
    <view class="boot-hint text-secondary">正在接通星图…</view>
  </view>

  <!-- 已启航：欢迎回归（垂直居中；轻氛围仅横线+✦+硬投影） -->
  <view wx:elif="{{phase === 'welcome'}}" class="welcome-back">
    <view class="welcome-lines" aria-hidden="true"></view>
    <view class="welcome-core">
      <view class="welcome-kicker"><text class="welcome-kicker-star">✦</text> ORBIT RETURN · 星轨重连完成</view>
      <view class="welcome-q">
        <xingcheng-q-entry scene="welcome-back" motion="{{reduceMotion ? 'still' : 'auto'}}" size="430"/>
      </view>
      <view class="welcome-title">欢迎<text class="h-orange">回归</text><text class="welcome-spark">✦</text></view>
      <view class="welcome-sub">星题舱已就绪，今天也来充一格星能。</view>
      <view class="welcome-route" aria-hidden="true">
        <view class="welcome-route-dot dot-cyan"></view><text>返航信号已确认</text>
        <view class="welcome-route-line"></view>
        <view class="welcome-route-dot dot-orange"></view><text>今日星站已就绪</text>
      </view>
      <view wx:if="{{welcomeStreak > 0}}" class="welcome-streak">连续星能 {{welcomeStreak}} 天</view>
      <button class="btn btn-orange btn-block welcome-cta uv-press" bindtap="enterToday" hover-class="uv-press-hover" hover-start-time="0" hover-stay-time="120">进入今日星站</button>
    </view>
  </view>

  <block wx:else>
  <view class="topbar" wx:if="{{step !== 'access'}}">
    <view class="back-btn uv-press" bindtap="back" hover-class="uv-press-hover" hover-start-time="0" hover-stay-time="120"><image src="/assets/icons/ic-back.png" mode="aspectFit"/></view>
    <view class="nav-right"></view>
  </view>

  <!-- 白名单门槛 -->
  <view wx:if="{{step === 'access'}}" class="gate">
    <view class="gate-q">
      <xingcheng-q-scene scene="{{accessLoading ? 'loading' : 'waiting'}}" motion="{{reduceMotion ? 'still' : 'auto'}}" size="210" once="{{false}}"/>
    </view>
    <view class="star-gate-ring"></view>
    <view class="eyebrow center">INVITATION SIGNAL</view>
    <view class="page-title center mt-s">{{accountUnavailable ? '账号已注销' : '等待开通 · 等待星门邀请'}}</view>
    <view wx:if="{{accountUnavailable}}" class="page-sub center">账号已停用，暂时无法访问学习服务。</view>
    <view wx:else class="page-sub center">把下方身份码发给运营人员，<br/>添加后点击“重新检测”即可进入。</view>
    <view class="access-code-card" wx:if="{{accessCode}}">
      <view class="access-code-label">我的学生身份码</view>
      <view class="access-code-value">{{accessCode}}</view>
      <button class="access-code-copy uv-taprow" bindtap="copyAccessCode" hover-class="uv-taprow-hover" hover-start-time="0" hover-stay-time="80" >复制身份码</button>
    </view>
    <button class="btn btn-cyan-o btn-block mt-l uv-press" bindtap="backWechat" hover-class="uv-press-hover" hover-start-time="0" hover-stay-time="120">返回微信</button>
    <button class="btn btn-orange btn-block mt uv-press" loading="{{accessLoading}}" disabled="{{accessLoading}}" bindtap="refreshAccess" hover-class="uv-press-hover" hover-start-time="0" hover-stay-time="120">{{accountUnavailable ? '重新检查账号状态' : '已收到邀请，重新检测'}}</button>
  </view>

  <!-- 选学科 -->
  <view wx:elif="{{step === 'subjects'}}">
    <view class="ob-hero row between">
      <view class="flex1">
        <view class="eyebrow">STAR FIELD</view>
        <view class="page-title">选择你的<text class="h-orange">星图领域</text></view>
      </view>
      <xingcheng-q-entry wx:if="{{!editMode}}" scene="first-login" motion="{{firstLoginMotion}}" size="320"/>
      <xingcheng-q wx:else state="rest" accessory="none" motion="still" size="92"/>
    </view>
    <view class="page-sub mb">至少选择 1 个领域，之后可以在「我的星籍」中调整。</view>
    <view wx:if="{{!editMode}}" class="launch-route">
      <view class="launch-step"><text class="launch-step-no">01</text><text>选领域</text></view>
      <view class="launch-arrow">·······</view>
      <view class="launch-step"><text class="launch-step-no">02</text><text>答星题</text></view>
      <view class="launch-arrow">·······</view>
      <view class="launch-step"><text class="launch-step-no">03</text><text>亮星轨</text></view>
    </view>

    <view wx:for="{{subjects}}" wx:key="name" data-name="{{item.name}}" bindtap="toggleSubject"
      class="subject-card card {{item.selected ? 'subject-on' : ''}} card-tilt-{{index === 0 ? 'l' : 'r'}} uv-taprow" hover-class="uv-taprow-hover" hover-start-time="0" hover-stay-time="80" >
      <view class="subject-icon {{item.theme}}">{{item.short}}</view>
      <view class="flex1">
        <view class="subject-name">{{item.name}}</view>
        <view class="muted" style="font-size:22rpx">{{item.detail}}</view>
      </view>
      <view class="subject-check {{item.selected ? 'checked' : ''}}">{{item.selected ? '✓' : ''}}</view>
    </view>

    <view class="select-count muted mt">已选 {{selectedCount}} 个领域{{selectedCount ? '，可以启航了' : '，至少选择 1 个'}}</view>
    <button class="btn btn-orange btn-block mt-l uv-press" loading="{{subjectSaving}}" disabled="{{subjectSaving || loading}}" bindtap="nextFromSubjects" hover-class="uv-press-hover" hover-start-time="0" hover-stay-time="120">{{editMode ? '保存领域' : '进入星题舱'}}</button>
  </view>

  <!-- 协议 -->
  <view wx:else>
    <view class="ob-hero row between">
      <view class="flex1">
        <view class="eyebrow">BEFORE LAUNCH</view>
        <view class="page-title">启航前的<text class="h-cyan">星航约定</text></view>
      </view>
      <xingcheng-q state="attention" accessory="none" motion="still" size="92"/>
    </view>
    <view class="page-sub mb">在开始每日一题之前，请确认以下条款。</view>

    <view class="agreement card card-answer mb uv-taprow" data-title="星航隐私条款" bindtap="showPolicy" hover-class="uv-taprow-hover" hover-start-time="0" hover-stay-time="80" >
      <view class="row between">
        <view class="agreement-title">星航隐私条款</view>
        <text class="agreement-link">查看全文 ›</text>
      </view>
      <view class="muted" style="font-size:22rpx">我们如何收集与保护你的学习数据，以及如何管理星籍档案。</view>
    </view>
    <view class="agreement card card-answer mb uv-taprow" data-title="星航用户协议" bindtap="showPolicy" hover-class="uv-taprow-hover" hover-start-time="0" hover-stay-time="80" >
      <view class="row between">
        <view class="agreement-title">星航用户协议</view>
        <text class="agreement-link">查看全文 ›</text>
      </view>
      <view class="muted" style="font-size:22rpx">使用量子星橙服务需遵守的约定，以及内测阶段说明。</view>
    </view>

    <view class="agree-row row gap-s uv-taprow" bindtap="toggleAgree" hover-class="uv-taprow-hover" hover-start-time="0" hover-stay-time="80" >
      <view class="agree-box {{agreed ? 'checked' : ''}}">{{agreed ? '✓' : ''}}</view>
      <text class="agree-copy">我已阅读并同意《星航隐私条款》与《星航用户协议》</text>
    </view>
    <button class="btn btn-yellow btn-block mt-l {{!agreed ? 'is-disabled' : ''}} uv-press" loading="{{launching}}" disabled="{{launching}}" bindtap="launch" hover-class="uv-press-hover" hover-start-time="0" hover-stay-time="120">同意并启航</button>
  </view>
  </block>
</view>
