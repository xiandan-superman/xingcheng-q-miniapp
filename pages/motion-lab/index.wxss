/* ============================================================
   动效试验舱 · 页面级样式
   仅承载"对照台"自身版式，动效本体全部来自 styles/uv-kit.wxss
   ============================================================ */

.lab { padding-bottom: 60rpx; }

/* 输入框占位符 */
.lab-ph { color: rgba(23, 25, 31, .32); }

/* 闸门开着时的醒目提示 */
.lab-gate-warn { margin-top: 20rpx; font-weight: 700; }

/* 卡片标题行 */
.lab-head {
  flex-direction: row;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}
.lab-name {
  font-family: "ZCOOL KuaiLe Local", sans-serif;
  font-size: 32rpx;
  line-height: 1.2;
}

/* "用在哪个页面"的场景标签 */
.lab-scene {
  display: inline-block;
  margin-bottom: 18rpx;
  padding: 4rpx 16rpx;
  background: var(--qblue);
  color: var(--cream-hi);
  border-radius: 8rpx;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: .5rpx;
}

/* 协议文案（对齐 onboarding 的字号） */
.lab-consent {
  flex: 1;
  font-size: 25rpx;
  line-height: 1.5;
}

/* 演示区：给足留白，方便真机点按 */
.lab-demo {
  padding: 24rpx;
  background: var(--cream-hi);
  border: 3rpx dashed rgba(23, 25, 31, .22);
  border-radius: 20rpx;
}
.lab-demo.center-flex { display: flex; flex-direction: row; justify-content: center; }
.lab-demo.col { display: flex; flex-direction: column; }

.lab-option { font-size: 26rpx; font-weight: 700; color: var(--ink); }
.lab-spark { font-size: 56rpx; line-height: 1; }
.lab-big {
  font-family: "ZCOOL KuaiLe Local", sans-serif;
  font-size: 56rpx;
  line-height: 1.1;
}

/* 说明文案 */
.lab-note {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1.55;
  color: var(--muted);
}
.lab-tip {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed rgba(23, 25, 31, .16);
  font-size: 23rpx;
  line-height: 1.6;
  color: #2F3640;
}

/* 段落里的补充提示 */
.lab-hint {
  display: block;
  margin-bottom: 6rpx;
  color: #B45004;
  font-weight: 700;
}

/* 行内代码 */
.code {
  display: inline-block;
  padding: 1rpx 8rpx;
  margin: 0 2rpx;
  background: var(--qblue);
  color: var(--cream-hi);
  border-radius: 6rpx;
  font-family: Menlo, Consolas, monospace;
  font-size: 21rpx;
}

/* 结果反馈演示件 */
.stamp {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 26rpx;
  border: 3rpx solid var(--ink);
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 900;
  box-shadow: 4rpx 5rpx 0 rgba(23, 25, 31, .85);
}
.stamp-ok { background: var(--green); color: var(--ink); }
.stamp-err { background: var(--red); color: #fff; }

/* 进度条演示件：厚底槽 + 内凹阴影，比灰底平条更像贴纸 */
.lab-progress {
  position: relative;
  height: 30rpx;
  overflow: hidden;
  background: var(--cream);
  border: 3rpx solid var(--ink);
  border-radius: 999rpx;
  box-shadow: inset 0 4rpx 0 rgba(23, 25, 31, .10);
}
.lab-progress-fill {
  position: relative;
  height: 100%;
  width: 60%;
  overflow: hidden;
  background: var(--orange);
  border-radius: 999rpx;
  box-shadow: inset 0 -7rpx 0 rgba(0, 0, 0, .13),
              inset 0 4rpx 0 rgba(255, 255, 255, .35);
}

/* 列表错峰演示件 */
.lab-row {
  display: flex; flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  background: #fff;
  border: 2rpx solid var(--ink);
  border-radius: 14rpx;
  font-size: 25rpx;
  box-shadow: 2rpx 3rpx 0 rgba(23, 25, 31, .18);
}
.lab-row + .lab-row { margin-top: 12rpx; }
.lab-row-idx {
  width: 40rpx;
  height: 40rpx;
  flex: none;
  display: flex; flex-direction: row;
  align-items: center;
  justify-content: center;
  background: var(--cyan);
  border: 2rpx solid var(--ink);
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: 800;
}

/* 弹层手柄的热区：视觉细，触控大 */
.lab-grip-hit { padding: 16rpx 0 20rpx; }
.lab-grip-hit .uv-sheet-grip { margin: 0 auto; }

.lab-foot {
  margin-top: 40rpx;
  text-align: center;
}
