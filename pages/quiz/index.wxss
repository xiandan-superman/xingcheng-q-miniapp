/* ============ 答题页（顶部间距由 JS 精确注入） ============ */

.timer-sticker {
  background: var(--yellow);
  border: 3rpx solid var(--ink);
  border-radius: 12rpx;
  padding: 8rpx 20rpx;
  font-size: 26rpx;
  font-weight: 900;
  box-shadow: 3rpx 4rpx 0 rgba(23,25,31,.85);
  transform: rotate(-2deg);
  font-variant-numeric: tabular-nums;
}

/* 跃迁能量束 */
.beam {
  position: relative;
  display: flex; flex-direction: row;
  gap: 10rpx;
  margin: 18rpx 8rpx 0;
  padding-right: 60rpx;
}
.beam-seg {
  flex: 1;
  height: 18rpx;
  border-radius: 99rpx;
  border: 2rpx solid var(--ink);
  background: rgba(23,25,31,.08);
  transition: background .3s ease;
}
.beam-seg.seg-1 { background: var(--orange); box-shadow: 0 0 10rpx rgba(255,138,42,.6); }
.beam-seg.seg-2 { background: var(--cyan); box-shadow: 0 0 10rpx rgba(53,216,240,.5); }
.beam-seg.seg-1, .beam-seg.seg-2 { animation: beam-glow 1.4s ease-in-out infinite; }
@keyframes beam-glow {
  0%, 100% { filter: brightness(1); }
  50% { filter: brightness(1.12); }
}
.beam-q {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx; height: 56rpx;
  display: flex; flex-direction: row; align-items: center; justify-content: center;
 background: transparent; }
.beam-copy { font-size: 21rpx; color: var(--ink); margin: 10rpx 8rpx 0; padding-right: 60rpx; }
.beam-copy text { opacity: .55; font-weight: 700; }
.beam-stage { color: var(--orange); font-weight: 800; opacity: 1 !important; }

/* 题干卡 */
.stem-card { padding: 28rpx; }
.stem-text { font-size: 31rpx; font-weight: 800; line-height: 1.6; }
.stem-sub { font-size: 24rpx; color: var(--muted); line-height: 1.65; }

/* 题干内嵌相图 */
.stem-diagram { margin-top: 24rpx; padding-top: 20rpx; border-top: 2rpx dashed rgba(23,25,31,.12); }
/* 相图卡（旧独立卡保留类名兼容） */
.diagram-card { padding: 24rpx; }
.diagram-title {
  font-family: "ZCOOL KuaiLe Local", sans-serif;
  font-size: 30rpx;
}
.zoom-btn {
  background: var(--cyan);
  border: 3rpx solid var(--ink);
  border-radius: 99rpx;
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  font-weight: 800;
  box-shadow: 2rpx 3rpx 0 rgba(23,25,31,.85);
}
.diagram-frame {
  position: relative;
  border: 3rpx solid var(--ink);
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--card);
}
.diagram-image { width: 100%; display: block; }
.corner {
  position: absolute;
  color: var(--orange);
  font-size: 22rpx;
}
.c1 { top: 8rpx; left: 10rpx; } .c2 { top: 8rpx; right: 10rpx; }
.c3 { bottom: 8rpx; left: 10rpx; } .c4 { bottom: 8rpx; right: 10rpx; }

/* 小问作答卡 */
.subq { padding: 26rpx; }
.sq-head { margin-bottom: 8rpx; }
.sq-num {
  width: 48rpx; height: 48rpx; flex: none;
  border-radius: 12rpx;
  border: 3rpx solid var(--ink);
  display: flex; flex-direction: row; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 900; color: var(--card);
}
.num-orange { background: var(--orange); }
.num-cyan { background: var(--cyan); color: var(--ink); }
.num-pink { background: var(--pink); }
.sq-title {
  font-family: "ZCOOL KuaiLe Local", sans-serif;
  font-size: 30rpx;
}
.sq-prompt { font-size: 23rpx; margin-bottom: 16rpx; color: var(--ink); }
.sq-input-wrap {
  position: relative;
  background: var(--card);
  border: 3rpx solid var(--ink);
  border-radius: 18rpx;
  padding: 20rpx 22rpx 20rpx 56rpx;
  transition: border-color .2s ease, box-shadow .2s ease;
}
.sq-input-wrap.focus { border-color: var(--orange); box-shadow: 0 0 0 4rpx rgba(255,138,42,.18); }
.sq-pen { position: absolute; top: 20rpx; left: 18rpx; width: 30rpx; height: 30rpx; }
.sq-input { width: 100%; min-height: 150rpx; font-size: 27rpx; line-height: 1.6; color: var(--ink); }
.sq-ph { color: var(--muted); font-size: 25rpx; }

/* 纠错弹层 */
.type-label { font-size: 26rpx; font-weight: 800; margin-bottom: 14rpx; }

/* 错题来源标识 */
.wrong-source {
  display: flex; flex-direction: row;
  align-items: center;
  gap: 10rpx;
  background: var(--red-bg);
  border: 2rpx solid rgba(255,90,100,.4);
  border-radius: 12rpx;
  padding: 12rpx 18rpx;
  font-size: 23rpx;
  color: var(--red-deep);
  font-weight: 700;
  margin-bottom: 16rpx;
}

/* 加载 / 错误态 */
.quiz-state { padding: 120rpx 40rpx; }
.quiz-msg { font-size: 27rpx; color: var(--muted); margin-top: 20rpx; text-align: center; }

/* 题组进度 */
.group-prog { margin: 8rpx 4rpx 0; }
.gp-bar {
  height: 18rpx;
  border-radius: 99rpx;
  border: 2rpx solid var(--ink);
  background: rgba(23,25,31,.08);
  overflow: hidden;
}
.gp-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--cyan), var(--orange));
  border-radius: 99rpx;
  transition: width .4s ease;
}
.gp-copy { font-size: 21rpx; margin-top: 8rpx; }

/* 选择题选项 */
.options { display: flex; flex-direction: column; gap: 18rpx; }
.multi-tip { font-size: 21rpx; text-align: center; margin-top: 6rpx; }


/* 纠错弹层 SCREEN9 */
.corr-sheet { max-height: 92vh; overflow-y: auto; }
.corr-head { margin-bottom: 16rpx; }
.corr-sub { text-align: center; font-size: 24rpx; color: var(--muted); margin-top: 8rpx; }
.corr-qcard { padding: 20rpx 22rpx; background: var(--cyan-bg); box-shadow: 4rpx 6rpx 0 rgba(53,216,240,.28); }
.corr-q-label { font-size: 22rpx; color: var(--muted); margin-bottom: 6rpx; }
.corr-q-meta { font-size: 26rpx; font-weight: 800; margin-bottom: 6rpx; }
.corr-q-stem { font-size: 24rpx; color: var(--ink); line-height: 1.5; }
.corr-img-box {
  border: 3rpx dashed var(--ink); border-radius: 16rpx;
  padding: 28rpx 20rpx; text-align: center; opacity: .85; background: rgba(255,255,255,.6);
}
.corr-img-ico { width: 48rpx; height: 48rpx; }
.corr-img-hint { font-size: 22rpx; color: var(--muted); margin-top: 8rpx; }
.corr-preview {
  width: 100%; max-height: 280rpx; border-radius: 12rpx; border: 2rpx solid var(--ink); background: var(--card);
}
.corr-foot { text-align: center; margin-top: 14rpx; font-size: 22rpx; color: var(--muted); line-height: 1.5; }
.type-label { font-size: 26rpx; font-weight: 800; margin-bottom: 12rpx; color: var(--ink); }


/* R8 键盘避让：内容可滚，底栏实底不透白缝 */
.quiz-scroll {
  width: 100%;
  box-sizing: border-box;
  padding: 0 0 24rpx;
}
.quiz-action-bar {
  background: var(--paper) !important;
  box-shadow: 0 -8rpx 24rpx rgba(23,25,31,.06);
}
.quiz-action-bar.kb-up {
  background: var(--paper) !important;
  border-top: 2rpx solid rgba(23,25,31,.08);
  padding-bottom: 18rpx;
}
.quiz-err-actions { justify-content: center; flex-wrap: wrap; }
.quiz-err-actions .btn { min-width: 200rpx; }

/* 星轨选项补充：多选题可多颗行星点亮，但轨道不转（整屏循环动画红线） */
.options.is-multi .uv-radio-orbit.is-on .uv-radio-planet::before { animation: none; }

/* 已确认的页面细节优化：不修改角色选择器 */
.stem-text { line-height:1.85; font-weight:500; overflow-wrap:break-word; }
.stem-diagram { margin-top:28rpx; }
.uv-radio-body { min-width:0; }
.uv-radio-txt { line-height:1.75; overflow-wrap:break-word; }
.uv-radio-orbit { transition:background-color .18s ease,border-color .18s ease; }
.gp-copy { font-size:24rpx; }
.flow-hint { font-size:24rpx; line-height:1.6; color:var(--muted); margin:12rpx 0; }
.reduce-motion .uv-radio-orbit { transition:none; }
.stem-card { position:relative; }
.stem-role { float:right; width:232rpx; height:232rpx; margin:-18rpx -12rpx 12rpx 18rpx; }
.correction-success-card { text-align:center; display:flex; flex-direction:column; align-items:center; }
