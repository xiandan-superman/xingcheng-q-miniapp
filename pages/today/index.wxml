<view class="page today safe-bottom tab-page has-brandrow page-fade {{reduceMotion ? 'reduce-motion' : ''}}" style="padding-top:{{topPad}}px">
  <!-- 自绘通知（替代 wx.showToast 系统样式） -->
  <view wx:if="{{uvToast.show}}" class="uv-toast {{uvToast.type === 'err' ? 'uv-toast-err' : uvToast.type === 'star' ? '' : 'uv-toast-info'}}">
    <text class="uv-toast-star">{{uvToast.type === 'err' ? '✗' : uvToast.type === 'star' ? '★' : '✦'}}</text>
    <text class="uv-toast-txt">{{uvToast.text}}</text>
    <view class="uv-toast-bar"></view>
  </view>
  <view wx:if="{{networkRecovered}}" class="network-recovered card card-data"><xingcheng-q-scene scene="recovered" motion="{{reduceMotion ? 'still' : 'auto'}}" size="160"/><view><view class="makeup-empty-title">星图已重新接通</view><view class="makeup-empty-sub">内容已经恢复，可以继续使用。</view></view></view>
  <!-- 顶部品牌锁（与微信胶囊同高，右侧留给胶囊） -->
  <view class="topbar brand-row">
    <view class="brand-lock">
      <image class="brand-logo" src="/assets/icons/logo-q.png" mode="aspectFit"/>
      <view>
        <view class="brand-name">量子星橙</view>
        <view class="brand-sub">DAILY QUANTUM · {{dateText}}</view>
      </view>
    </view>
  </view>
  <!-- 标题区 -->
  <view class="hero {{!completed && !showMakeup && !message ? 'hero-with-q' : 'hero-compact'}}">
    <view class="streak-row"><view class="sticker streak-sticker">连续星能 {{streak}} 天 ✦</view></view>
    <view class="hero-copy">
      <view class="hero-title" wx:if="{{!completed}}">
        <view class="hero-title-line">今天也来<text class="h-orange">充</text></view>
        <view class="hero-title-line"><text class="hl">一格星能</text></view>
      </view>
      <view class="hero-title" wx:else>
        <view class="hero-title-line">今天的星题</view>
        <view class="hero-title-line"><text class="hl" style="background:var(--green)">已点亮</text></view>
      </view>
      <view class="hero-sub">每天一道，星光不乱卷</view>
      <view class="hero-mission">
        <view class="hero-mission-kicker">TODAY'S MISSION</view>
        <view class="hero-mission-main"><text class="mission-star">✦</text><text>完成今日星题</text></view>
        <view class="hero-mission-sub">点亮一格星能</view>
      </view>
    </view>
    <view wx:if="{{!completed && !showMakeup && !message}}" class="home-theater">
      <xingcheng-q-home motion="{{reduceMotion ? 'still' : 'auto'}}" size="330"/>
    </view>
  </view>

  <!-- 今日星题卡 -->
  <view wx:if="{{loading}}" class="card mt load-inline">
    <view class="load-orbit" aria-hidden="true"><view class="load-orbit-core"></view></view>
    <view class="load-txt">正在读取今日星题…</view>
  </view>
  <view wx:elif="{{message}}" class="card mt system-card">
    <xingcheng-q-scene scene="{{messageScene}}" motion="{{reduceMotion ? 'still' : 'auto'}}" size="160"/>
    <view class="load-txt">{{message}}</view>
    <button class="btn btn-small mt uv-press" bindtap="load" hover-class="uv-press-hover" hover-start-time="0" hover-stay-time="120">重新加载</button>
  </view>
  <view wx:if="{{question && !loading}}" class="question-card card card-cream anim-in {{completed ? 'is-done' : ''}}">
    <view class="tape {{completed ? 'tape-green' : ''}}"></view>
    <view class="q-badge starbadge {{completed ? 'green' : ''}}">Q✦</view>
    <view class="row gap-s wrap tags">
      <text class="pill pill-fill-pink">{{question.type}}</text>
      <text class="pill pill-fill-blue">{{question.subject}}</text>
      <text class="pill pill-fill-cyan" wx:if="{{question.hasImage}}">含相图</text>
    </view>
    <view class="question-label">今日星题 · {{completed ? '已完成' : '待作答'}}</view>
    <view class="question-summary">{{question.summary}}</view>
    <view wx:if="{{completed}}" class="completion-q"><xingcheng-q-variety scene="completion-seal" motion="{{completionMotion}}" size="200"/></view>
    <view class="estimate row gap-s">
      <image src="/assets/icons/ic-clock.png" mode="aspectFit" style="width:32rpx;height:32rpx"/>
      <text>按自己的节奏作答，进入深度跃迁</text>
    </view>
    <button wx:if="{{!completed}}" class="btn btn-yellow btn-block mt btn-pulse uv-press" bindtap="startDaily" hover-class="uv-press-hover" hover-start-time="0" hover-stay-time="120">开始答题</button>
    <button wx:else class="btn btn-cyan-o btn-block mt uv-press" bindtap="reviewDaily" hover-class="uv-press-hover" hover-start-time="0" hover-stay-time="120">回看星图</button>
  </view>

  <!-- 星能轨迹 -->
  <view class="sec-title">我的星能轨迹</view>
  <view class="track card">
    <view class="track-stats row">
      <view class="track-stat"><text class="energy-num h-orange">{{streak}}</text><text class="track-label">连续星能（天）</text></view>
      <view class="track-stat"><text class="energy-num h-cyan">{{total}}</text><text class="track-label">累计星能（天）</text></view>
      <view class="track-stat flex1" style="align-items:flex-end">
        <button class="btn btn-small btn-orange uv-press" bindtap="openMakeup" hover-class="uv-press-hover" hover-start-time="0" hover-stay-time="120">补签记录 · 回溯补能 · 剩{{tickets}}</button>
      </view>
    </view>

    <view class="orbit">
      <view class="orbit-line"></view>
      <view class="orbit-days">
        <view wx:for="{{days}}" wx:key="key" class="orbit-day">
          <view class="orbit-star star-{{item.state}} {{selectedKey === item.key ? 'star-picked' : ''}}">
            <text wx:if="{{item.state === 'done'}}">★</text>
            <text wx:elif="{{item.state === 'today'}}">★</text>
            <text wx:else>☆</text>
          </view>
          <view class="orbit-date">{{item.day}}</view>
          <view class="orbit-label">{{item.label}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 补卡弹层 -->
  <view wx:if="{{showMakeup}}" class="overlay uv-taprow" bindtap="closeMakeup" hover-class="uv-taprow-hover" hover-start-time="0" hover-stay-time="80" >
    <view class="sheet makeup-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="makeup-head mb-s">
        <view class="eyebrow">TIME TRACE</view>
        <view class="sheet-title" style="text-align:left">补签记录 · 回溯补能</view>
      </view>
      <view class="hero-sub mb">补能只能回到最近 30 天内未打卡的日期，不需要重做星题。</view>
      <view class="ticket row between mb">
        <text>剩余补能券</text>
        <text class="sticker sticker-yellow">{{tickets}} 次</text>
      </view>
      <view wx:if="{{makeupSuccess}}" class="makeup-success mb">
        <xingcheng-q-scene scene="makeup" motion="{{reduceMotion ? 'still' : 'auto'}}" size="220"/>
        <view class="makeup-empty-title">回溯补能成功</view>
        <view class="makeup-empty-sub">漏掉的星能已经找回，星轨记录已更新。</view>
      </view>
      <view wx:elif="{{tickets <= 0}}" class="makeup-empty mb">
        <view class="makeup-empty-title">暂无补能券</view>
        <view class="makeup-empty-sub">完成连续星能或活动补给后可回溯最近 30 天漏打日期。</view>
      </view>
      <scroll-view wx:if="{{!makeupSuccess}}" scroll-y class="makeup-scroll" enhanced show-scrollbar="{{true}}">
        <view class="makeup-strip">
          <view wx:for="{{makeupDays}}" wx:key="key"
            class="mk-day mk-{{item.state}} {{selectedKey === item.key ? 'mk-picked' : ''}} {{!item.canMakeup || tickets <= 0 ? 'mk-locked' : ''}} uv-taprow"
            data-key="{{item.key}}" data-makeup="{{item.canMakeup}}" bindtap="pickDay" hover-class="uv-taprow-hover" hover-start-time="0" hover-stay-time="80" >
            <text class="mk-star">{{item.state === 'done' ? '★' : '☆'}}</text>
            <text class="mk-date">{{item.day}}</text>
            <text class="mk-label">{{item.label}}</text>
          </view>
        </view>
      </scroll-view>
      <view wx:if="{{!makeupSuccess}}" class="makeup-foot">
        <view class="mk-legend row gap">
          <text class="lg"><text class="lg-dot" style="background:var(--orange)"></text>已打卡</text>
          <text class="lg"><text class="lg-dot" style="background:transparent;border:2rpx dashed var(--orange)"></text>可补能</text>
          <text class="lg"><text class="lg-dot" style="background:var(--yellow)"></text>已选中</text>
        </view>
        <button class="btn btn-orange btn-block mt uv-press" disabled="{{tickets <= 0 || !selectedKey}}" bindtap="confirmMakeup" hover-class="uv-press-hover" hover-start-time="0" hover-stay-time="120">{{tickets <= 0 ? '暂无补能券' : '确认补签'}}</button>
      </view>
      <button wx:else class="btn btn-orange btn-block mt uv-press" bindtap="closeMakeup" hover-class="uv-press-hover" hover-start-time="0" hover-stay-time="120">完成</button>
    </view>
  </view>
</view>
